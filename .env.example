# Copy this file to .env and fill in the keys you need.
# Never share or commit this file - it holds credentials.

# --- Model provider ---
# Default: openrouter (https://openrouter.ai/) with DeepSeek Flash. One key
# unlocks a large catalogue including free-tier models that rotate monthly.
# OPENROUTER_API_KEY=

# --- Delivery channel (optional) ---
# WhatsApp: run `hermes whatsapp` for QR pairing. Telegram: bot via @BotFather.
# TELEGRAM_BOT_TOKEN=

# --- Connections (optional): calendar, mail, tasks via Maton ---
# Free account at https://maton.ai - see docs/connections.md.
# MATON_API_KEY=

# --- Local models / voice need no keys ---
# LM Studio (http://localhost:1234/v1) or Ollama (http://localhost:11434/v1).
# Voice: local Piper TTS and faster-whisper STT. See docs/models.md.
